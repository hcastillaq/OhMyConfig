#!/usr/bin/env bash
# ==============================================================================
# omc — OhMyConfig CLI Entry Point (Bash 3.2+)
# ==============================================================================
# Usage:
#   ./omc install              Interactive installer with module selection
#   ./omc install --all        Install all modules non-interactively
#   ./omc install --all --link Install all in symlink mode
#   ./omc doctor               Diagnose installed tools, packages, and symlinks
#   ./omc update               Update brew formulas + casks + global npm packages
#   ./omc --version            Show version (from VERSION file)
#   ./omc --help               Show this help
# ==============================================================================

set -e

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VERSION_FILE="$DOTFILES_DIR/VERSION"
if [ ! -r "$VERSION_FILE" ]; then
    printf '%s\n' "[ERROR] Missing project version file: $VERSION_FILE" >&2
    exit 1
fi
OMC_VERSION="$(tr -d ' \n\r' < "$VERSION_FILE")"
if [ -z "$OMC_VERSION" ]; then
    printf '%s\n' "[ERROR] Project version file is empty: $VERSION_FILE" >&2
    exit 1
fi
export OMC_VERSION
CMD="${1:-}"

# Source core libs
source "$DOTFILES_DIR/cli/lib/brew.sh"

# Bootstrap: ensure Homebrew environment and gum are available for TUI commands
case "$CMD" in
    --help|-h|help|--version|-v|version|"")
        ;;
    *)
        brew_ensure_env
        gum_ensure
        ;;
esac

case "$CMD" in
    --version|-v|version)
        echo "OhMyConfig (omc) v$OMC_VERSION"
        exit 0
        ;;

    install)
        source "$DOTFILES_DIR/cli/commands/install.sh"
        shift || true
        cmd_install "$@"
        ;;

    doctor)
        source "$DOTFILES_DIR/cli/commands/doctor.sh"
        cmd_doctor
        ;;

    update)
        source "$DOTFILES_DIR/cli/commands/update.sh"
        cmd_update
        ;;

    --help|-h|help|"")
        echo ""
        echo "OhMyConfig CLI - omc v$OMC_VERSION"
        echo ""
        echo "  Instalador interactivo, diagnóstico y gestor de herramientas"
        echo "  del entorno de desarrollo OhMyConfig."
        echo ""
        echo "  COMANDOS:"
        echo ""
        echo "    install              Selección interactiva de módulos a instalar"
        echo "    install --all        Instala todos los módulos sin preguntar"
        echo "    install --all --link Instala todo en modo symlink (desarrollo de dotfiles)"
        echo ""
        echo "    doctor               Diagnóstico completo del entorno, paquetes y symlinks"
        echo ""
        echo "    update               Actualiza Homebrew, Pi y adaptadores Static Noise"
        echo ""
        echo "    --version, -v        Muestra la versión de OhMyConfig"
        echo "    --help, -h           Muestra esta ayuda"
        echo ""
        echo "  MÓDULOS DISPONIBLES:"
        echo ""
        echo "    core       Fish · Starship · mise · Atuin · Nerd Fonts"
        echo "    terminal   Ghostty · Zellij"
        echo "    editor     Neovim · Git-Delta · Lazygit · gh · Bat · Glow"
        echo "    search     rg · fd · fzf · sd · yazi · zoxide · eza · dust"
        echo "    cli        btm · procs · xh · jq · jqp · tokei · onefetch"
        echo "    devops     lazydocker · k9s · kubectx/kubens"
        echo "    ai         pi (Coding Agent en terminal)"
        echo ""
        echo "  DOCUMENTACIÓN:"
        echo "    https://hcastillaq.github.io/OhMyConfig/"
        echo ""
        ;;

    *)
        echo "omc: comando desconocido '$CMD'"
        echo "Ejecutá './omc --help' para ver los comandos disponibles."
        exit 1
        ;;
esac
