// ==============================================================================
// CONFIGURACIÓN DE ZELLIJ (TEMA TOKYONIGHT CON ALTO CONTRASTE DE FOCO)
// ==============================================================================

theme "tokyonight"
default_layout "default"
mouse_mode true
copy_command "pbcopy"
copy_on_select true
pane_frames true
simplified_ui false

// Estilo visual de marcos de ventanas
ui {
    pane_frames {
        rounded_corners true
        hide_session_name false
    }
}

// Atajos directos estilo Alt-first: evita que Zellij capture combinaciones Ctrl
// usadas por Neovim, Fish, readline y otras TUIs. Los defaults se limpian para
// que sólo existan los bindings declarados aquí.
keybinds clear-defaults=true {
    normal {
        // --- Navegación entre paneles ---
        bind "Alt Left" "Alt h" { MoveFocus "Left"; }
        bind "Alt Right" "Alt l" { MoveFocus "Right"; }
        bind "Alt Down" "Alt j" { MoveFocus "Down"; }
        bind "Alt Up" "Alt k" { MoveFocus "Up"; }

        // --- Acciones directas de panel ---
        bind "Alt n" { NewPane; }
        bind "Alt x" { CloseFocus; }
        bind "Alt f" { ToggleFocusFullscreen; }
        bind "Alt w" { ToggleFloatingPanes; }
        bind "Alt Shift h" { MovePane "Left"; }
        bind "Alt Shift j" { MovePane "Down"; }
        bind "Alt Shift k" { MovePane "Up"; }
        bind "Alt Shift l" { MovePane "Right"; }

        // --- Navegación y gestión directa de pestañas ---
        bind "Alt [" { GoToPreviousTab; }
        bind "Alt ]" { GoToNextTab; }
        bind "Alt t" { NewTab; }
        bind "Alt q" { CloseTab; }
        bind "Alt r" { SwitchToMode "RenameTab"; TabNameInput 0; }
        bind "Alt 1" { GoToTab 1; }
        bind "Alt 2" { GoToTab 2; }
        bind "Alt 3" { GoToTab 3; }
        bind "Alt 4" { GoToTab 4; }
        bind "Alt 5" { GoToTab 5; }
        bind "Alt 6" { GoToTab 6; }
        bind "Alt 7" { GoToTab 7; }
        bind "Alt 8" { GoToTab 8; }
        bind "Alt 9" { GoToTab 9; }

        // --- Modos de Zellij como fallback, sin prefijos Ctrl ---
        bind "Alt p" { SwitchToMode "Pane"; }
        bind "Alt Shift t" { SwitchToMode "Tab"; }
        bind "Alt m" { SwitchToMode "Move"; }
        bind "Alt z" { SwitchToMode "Resize"; }
        bind "Alt s" { SwitchToMode "Scroll"; }
        bind "Alt o" { SwitchToMode "Session"; }
        bind "Alt d" { Detach; }
    }

    pane {
        bind "Esc" "Enter" "Alt p" { SwitchToMode "Normal"; }
        bind "h" "Left" { MoveFocus "Left"; }
        bind "l" "Right" { MoveFocus "Right"; }
        bind "j" "Down" { MoveFocus "Down"; }
        bind "k" "Up" { MoveFocus "Up"; }
        bind "n" { NewPane; SwitchToMode "Normal"; }
        bind "d" { NewPane "Down"; SwitchToMode "Normal"; }
        bind "r" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "x" { CloseFocus; SwitchToMode "Normal"; }
        bind "f" { ToggleFocusFullscreen; SwitchToMode "Normal"; }
        bind "w" { ToggleFloatingPanes; SwitchToMode "Normal"; }
        bind "z" { TogglePaneFrames; SwitchToMode "Normal"; }
    }

    tab {
        bind "Esc" "Enter" "Alt Shift t" { SwitchToMode "Normal"; }
        bind "h" "Left" "Up" "k" { GoToPreviousTab; }
        bind "l" "Right" "Down" "j" { GoToNextTab; }
        bind "n" { NewTab; SwitchToMode "Normal"; }
        bind "x" { CloseTab; SwitchToMode "Normal"; }
        bind "r" { SwitchToMode "RenameTab"; TabNameInput 0; }
        bind "s" { ToggleActiveSyncTab; SwitchToMode "Normal"; }
        bind "1" { GoToTab 1; SwitchToMode "Normal"; }
        bind "2" { GoToTab 2; SwitchToMode "Normal"; }
        bind "3" { GoToTab 3; SwitchToMode "Normal"; }
        bind "4" { GoToTab 4; SwitchToMode "Normal"; }
        bind "5" { GoToTab 5; SwitchToMode "Normal"; }
        bind "6" { GoToTab 6; SwitchToMode "Normal"; }
        bind "7" { GoToTab 7; SwitchToMode "Normal"; }
        bind "8" { GoToTab 8; SwitchToMode "Normal"; }
        bind "9" { GoToTab 9; SwitchToMode "Normal"; }
    }

    move {
        bind "Esc" "Enter" "Alt m" { SwitchToMode "Normal"; }
        bind "Tab" "n" { MovePane; }
        bind "p" { MovePaneBackwards; }
        bind "h" "Left" { MovePane "Left"; }
        bind "j" "Down" { MovePane "Down"; }
        bind "k" "Up" { MovePane "Up"; }
        bind "l" "Right" { MovePane "Right"; }
    }

    resize {
        bind "Esc" "Enter" "Alt z" { SwitchToMode "Normal"; }
        bind "h" "Left" { Resize "Increase Left"; }
        bind "j" "Down" { Resize "Increase Down"; }
        bind "k" "Up" { Resize "Increase Up"; }
        bind "l" "Right" { Resize "Increase Right"; }
        bind "H" { Resize "Decrease Left"; }
        bind "J" { Resize "Decrease Down"; }
        bind "K" { Resize "Decrease Up"; }
        bind "L" { Resize "Decrease Right"; }
        bind "=" "+" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
    }

    scroll {
        bind "Esc" "Enter" "Alt s" { ScrollToBottom; SwitchToMode "Normal"; }
        bind "e" { EditScrollback; SwitchToMode "Normal"; }
        bind "s" { SwitchToMode "EnterSearch"; SearchInput 0; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "u" { HalfPageScrollUp; }
        bind "h" "Left" "PageUp" { PageScrollUp; }
        bind "l" "Right" "PageDown" { PageScrollDown; }
        bind "[" { ScrollToPreviousPrompt; }
        bind "]" { ScrollToNextPrompt; }
        bind "c" { CopyLastCommandOutput; SwitchToMode "Normal"; }
    }

    search {
        bind "Esc" "Enter" { ScrollToBottom; SwitchToMode "Normal"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "u" { HalfPageScrollUp; }
        bind "h" "Left" "PageUp" { PageScrollUp; }
        bind "l" "Right" "PageDown" { PageScrollDown; }
        bind "n" { Search "down"; }
        bind "p" { Search "up"; }
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "w" { SearchToggleOption "Wrap"; }
        bind "o" { SearchToggleOption "WholeWord"; }
    }

    entersearch {
        bind "Esc" { SwitchToMode "Scroll"; }
        bind "Enter" { SwitchToMode "Search"; }
    }

    renametab {
        bind "Esc" { UndoRenameTab; SwitchToMode "Normal"; }
        bind "Enter" { SwitchToMode "Normal"; }
    }

    session {
        bind "Esc" "Enter" "Alt o" { SwitchToMode "Normal"; }
        bind "d" { Detach; }
        bind "w" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Normal"
        }
        bind "c" {
            LaunchOrFocusPlugin "configuration" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Normal"
        }
        bind "p" {
            LaunchOrFocusPlugin "plugin-manager" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Normal"
        }
    }
}

themes {
    tokyonight {
        fg "#c0caf5"
        bg "#13141c"
        // Inactive pane border (borde tenue para paneles inactivos)
        black "#222638"
        red "#f7768e"
        // Active pane border & highlight (borde resaltado de alto contraste para el panel enfocado)
        green "#7dcfff"
        yellow "#e0af68"
        // Title bar del panel activo
        blue "#7aa2f7"
        magenta "#bb9af7"
        cyan "#7dcfff"
        white "#c0caf5"
        orange "#ff9e64"

        // Componentes modernos de Zellij: selección visible en menús,
        // listas, tablas, búsqueda y ribbons sin salir de Tokyonight Night.
        text_unselected {
            base 192 202 245        // #c0caf5
            background 19 20 28     // #13141c
            emphasis_0 125 207 255  // #7dcfff
            emphasis_1 122 162 247  // #7aa2f7
            emphasis_2 187 154 247  // #bb9af7
            emphasis_3 224 175 104  // #e0af68
        }

        text_selected {
            base 15 16 22           // #0f1016
            background 80 245 255   // #50f5ff
            emphasis_0 15 16 22     // #0f1016
            emphasis_1 247 118 142  // #f7768e
            emphasis_2 187 154 247  // #bb9af7
            emphasis_3 255 158 100  // #ff9e64
        }

        ribbon_unselected {
            base 192 202 245        // #c0caf5
            background 24 26 36     // #181a24
            emphasis_0 125 207 255  // #7dcfff
            emphasis_1 122 162 247  // #7aa2f7
            emphasis_2 187 154 247  // #bb9af7
            emphasis_3 224 175 104  // #e0af68
        }

        ribbon_selected {
            base 15 16 22           // #0f1016
            background 80 245 255   // #50f5ff
            emphasis_0 15 16 22     // #0f1016
            emphasis_1 247 118 142  // #f7768e
            emphasis_2 158 206 106  // #9ece6a
            emphasis_3 255 255 255  // #ffffff
        }

        list_unselected {
            base 192 202 245        // #c0caf5
            background 19 20 28     // #13141c
            emphasis_0 125 207 255  // #7dcfff
            emphasis_1 122 162 247  // #7aa2f7
            emphasis_2 187 154 247  // #bb9af7
            emphasis_3 224 175 104  // #e0af68
        }

        list_selected {
            base 255 255 255        // #ffffff
            background 53 75 138    // #354b8a
            emphasis_0 80 245 255   // #50f5ff
            emphasis_1 158 206 106  // #9ece6a
            emphasis_2 224 175 104  // #e0af68
            emphasis_3 247 118 142  // #f7768e
        }

        table_title {
            base 125 207 255        // #7dcfff
            background 24 26 36     // #181a24
            emphasis_0 255 255 255  // #ffffff
            emphasis_1 187 154 247  // #bb9af7
            emphasis_2 224 175 104  // #e0af68
            emphasis_3 158 206 106  // #9ece6a
        }

        table_cell_unselected {
            base 192 202 245        // #c0caf5
            background 19 20 28     // #13141c
            emphasis_0 125 207 255  // #7dcfff
            emphasis_1 122 162 247  // #7aa2f7
            emphasis_2 187 154 247  // #bb9af7
            emphasis_3 224 175 104  // #e0af68
        }

        table_cell_selected {
            base 255 255 255        // #ffffff
            background 53 75 138    // #354b8a
            emphasis_0 80 245 255   // #50f5ff
            emphasis_1 158 206 106  // #9ece6a
            emphasis_2 224 175 104  // #e0af68
            emphasis_3 247 118 142  // #f7768e
        }

        frame_unselected {
            base 34 38 56           // #222638
            background 19 20 28     // #13141c
            emphasis_0 122 136 207    // #7a88cf
            emphasis_1 154 165 206  // #9aa5ce
            emphasis_2 34 38 56     // #222638
            emphasis_3 24 26 36     // #181a24
        }

        frame_selected {
            base 125 207 255        // #7dcfff
            background 19 20 28     // #13141c
            emphasis_0 80 245 255   // #50f5ff
            emphasis_1 122 162 247  // #7aa2f7
            emphasis_2 255 255 255  // #ffffff
            emphasis_3 187 154 247  // #bb9af7
        }

        frame_highlight {
            base 80 245 255         // #50f5ff
            background 19 20 28     // #13141c
            emphasis_0 122 162 247  // #7aa2f7
            emphasis_1 187 154 247  // #bb9af7
            emphasis_2 224 175 104  // #e0af68
            emphasis_3 247 118 142  // #f7768e
        }

        exit_code_success {
            base 158 206 106        // #9ece6a
            background 19 20 28     // #13141c
            emphasis_0 125 207 255  // #7dcfff
            emphasis_1 122 162 247  // #7aa2f7
            emphasis_2 187 154 247  // #bb9af7
            emphasis_3 224 175 104  // #e0af68
        }

        exit_code_error {
            base 247 118 142        // #f7768e
            background 19 20 28     // #13141c
            emphasis_0 125 207 255  // #7dcfff
            emphasis_1 122 162 247  // #7aa2f7
            emphasis_2 187 154 247  // #bb9af7
            emphasis_3 224 175 104  // #e0af68
        }
    }
}
