// ==============================================================================
// CONFIGURACIÓN DE ZELLIJ (TEMA TOKYONIGHT CON ALTO CONTRASTE DE FOCO)
// ==============================================================================

theme "tokyonight"
default_layout "default"
mouse_mode true
copy_command "pbcopy"
copy_on_select true
pane_frames true
simplified_ui false

// Estilo visual de marcos de ventanas
ui {
    pane_frames {
        rounded_corners true
        hide_session_name false
    }
}

// Atajos directos para navegación fluida en Modo Normal
keybinds {
    normal {
        // Desvincular Ctrl+s en Zellij para que Neovim pueda guardar sin interrupciones
        unbind "Ctrl s"
        bind "Alt s" { SwitchToMode "Scroll"; }

        // --- Navegación entre paneles ---
        bind "Alt Left" "Alt h" { MoveFocus "Left"; }
        bind "Alt Right" "Alt l" { MoveFocus "Right"; }
        bind "Alt Down" "Alt j" { MoveFocus "Down"; }
        bind "Alt Up" "Alt k" { MoveFocus "Up"; }

        // --- Acciones directas de panel ---
        bind "Alt n" { NewPane; }
        bind "Alt f" { ToggleFocusFullscreen; }
        bind "Alt w" { ToggleFloatingPanes; }

        // --- Navegación entre pestañas ---
        bind "Alt [" { GoToPreviousTab; }
        bind "Alt ]" { GoToNextTab; }
        bind "Alt 1" { GoToTab 1; }
        bind "Alt 2" { GoToTab 2; }
        bind "Alt 3" { GoToTab 3; }
        bind "Alt 4" { GoToTab 4; }
        bind "Alt 5" { GoToTab 5; }
        bind "Alt 6" { GoToTab 6; }
        bind "Alt 7" { GoToTab 7; }
        bind "Alt 8" { GoToTab 8; }
        bind "Alt 9" { GoToTab 9; }
    }
}

themes {
    tokyonight {
        fg "#c0caf5"
        bg "#1a1b26"
        // Inactive pane border (borde tenue para paneles inactivos)
        black "#292e42"
        red "#f7768e"
        // Active pane border & highlight (borde resaltado de alto contraste para el panel enfocado)
        green "#7dcfff"
        yellow "#e0af68"
        // Title bar del panel activo
        blue "#7aa2f7"
        magenta "#bb9af7"
        cyan "#7dcfff"
        white "#c0caf5"
        orange "#ff9e64"
    }
}
