// ==============================================================================
// CONFIGURACIÓN DE ZELLIJ (TEMA STATIC NOISE CON ALTO CONTRASTE DE FOCO)
// ==============================================================================

theme "static-noise"
default_layout "default"
mouse_mode true
copy_command "pbcopy"
copy_on_select true
pane_frames true
simplified_ui false

// Estilo visual de marcos de ventanas
ui {
    pane_frames {
        rounded_corners true
        hide_session_name false
    }
}

// Atajos directos estilo Alt-first: evita que Zellij capture combinaciones Ctrl
// usadas por Neovim, Fish, readline y otras TUIs. Los defaults se limpian para
// que sólo existan los bindings declarados aquí.
keybinds clear-defaults=true {
    normal {
        // --- Navegación entre paneles ---
        bind "Alt Left" "Alt h" { MoveFocus "Left"; }
        bind "Alt Right" "Alt l" { MoveFocus "Right"; }
        bind "Alt Down" "Alt j" { MoveFocus "Down"; }
        bind "Alt Up" "Alt k" { MoveFocus "Up"; }

        // --- Acciones directas de panel ---
        bind "Alt n" { NewPane; }
        bind "Alt x" { CloseFocus; }
        bind "Alt f" { ToggleFocusFullscreen; }
        bind "Alt w" { ToggleFloatingPanes; }
        bind "Alt Shift h" { MovePane "Left"; }
        bind "Alt Shift j" { MovePane "Down"; }
        bind "Alt Shift k" { MovePane "Up"; }
        bind "Alt Shift l" { MovePane "Right"; }

        // --- Navegación y gestión directa de pestañas ---
        bind "Alt [" { GoToPreviousTab; }
        bind "Alt ]" { GoToNextTab; }
        bind "Alt t" { NewTab; }
        bind "Alt q" { CloseTab; }
        bind "Alt r" { SwitchToMode "RenameTab"; TabNameInput 0; }
        bind "Alt 1" { GoToTab 1; }
        bind "Alt 2" { GoToTab 2; }
        bind "Alt 3" { GoToTab 3; }
        bind "Alt 4" { GoToTab 4; }
        bind "Alt 5" { GoToTab 5; }
        bind "Alt 6" { GoToTab 6; }
        bind "Alt 7" { GoToTab 7; }
        bind "Alt 8" { GoToTab 8; }
        bind "Alt 9" { GoToTab 9; }

        // --- Modos de Zellij como fallback, sin prefijos Ctrl ---
        bind "Alt p" { SwitchToMode "Pane"; }
        bind "Alt Shift t" { SwitchToMode "Tab"; }
        bind "Alt m" { SwitchToMode "Move"; }
        bind "Alt z" { SwitchToMode "Resize"; }
        bind "Alt s" { SwitchToMode "Scroll"; }
        bind "Alt o" { SwitchToMode "Session"; }
        bind "Alt d" { Detach; }
    }

    pane {
        bind "Esc" "Enter" "Alt p" { SwitchToMode "Normal"; }
        bind "h" "Left" { MoveFocus "Left"; }
        bind "l" "Right" { MoveFocus "Right"; }
        bind "j" "Down" { MoveFocus "Down"; }
        bind "k" "Up" { MoveFocus "Up"; }
        bind "n" { NewPane; SwitchToMode "Normal"; }
        bind "d" { NewPane "Down"; SwitchToMode "Normal"; }
        bind "r" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "x" { CloseFocus; SwitchToMode "Normal"; }
        bind "f" { ToggleFocusFullscreen; SwitchToMode "Normal"; }
        bind "w" { ToggleFloatingPanes; SwitchToMode "Normal"; }
        bind "z" { TogglePaneFrames; SwitchToMode "Normal"; }
    }

    tab {
        bind "Esc" "Enter" "Alt Shift t" { SwitchToMode "Normal"; }
        bind "h" "Left" "Up" "k" { GoToPreviousTab; }
        bind "l" "Right" "Down" "j" { GoToNextTab; }
        bind "n" { NewTab; SwitchToMode "Normal"; }
        bind "x" { CloseTab; SwitchToMode "Normal"; }
        bind "r" { SwitchToMode "RenameTab"; TabNameInput 0; }
        bind "s" { ToggleActiveSyncTab; SwitchToMode "Normal"; }
        bind "1" { GoToTab 1; SwitchToMode "Normal"; }
        bind "2" { GoToTab 2; SwitchToMode "Normal"; }
        bind "3" { GoToTab 3; SwitchToMode "Normal"; }
        bind "4" { GoToTab 4; SwitchToMode "Normal"; }
        bind "5" { GoToTab 5; SwitchToMode "Normal"; }
        bind "6" { GoToTab 6; SwitchToMode "Normal"; }
        bind "7" { GoToTab 7; SwitchToMode "Normal"; }
        bind "8" { GoToTab 8; SwitchToMode "Normal"; }
        bind "9" { GoToTab 9; SwitchToMode "Normal"; }
    }

    resize {
        bind "Esc" "Enter" "Alt z" { SwitchToMode "Normal"; }
        bind "h" "Left" { Resize "Increase Left"; }
        bind "j" "Down" { Resize "Increase Down"; }
        bind "k" "Up" { Resize "Increase Up"; }
        bind "l" "Right" { Resize "Increase Right"; }
        bind "H" { Resize "Decrease Left"; }
        bind "J" { Resize "Decrease Down"; }
        bind "K" { Resize "Decrease Up"; }
        bind "L" { Resize "Decrease Right"; }
        bind "=" "+" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
    }

    move {
        bind "Esc" "Enter" "Alt m" { SwitchToMode "Normal"; }
        bind "h" "Left" { MovePane "Left"; }
        bind "j" "Down" { MovePane "Down"; }
        bind "k" "Up" { MovePane "Up"; }
        bind "l" "Right" { MovePane "Right"; }
        bind "n" "Tab" { MovePane; }
        bind "p" { MovePaneBackwards; }
    }

    scroll {
        bind "Esc" "Enter" "Alt s" { SwitchToMode "Normal"; }
        bind "e" { EditScrollback; SwitchToMode "Normal"; }
        bind "s" { SwitchToMode "EnterSearch"; SearchInput 0; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "u" { HalfPageScrollUp; }
        bind "f" "PageDown" { PageScrollDown; }
        bind "b" "PageUp" { PageScrollUp; }
    }

    search {
        bind "Esc" "Enter" { SwitchToMode "Normal"; }
        bind "s" { SwitchToMode "EnterSearch"; SearchInput 0; }
        bind "n" { Search "down"; }
        bind "p" { Search "up"; }
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "w" { SearchToggleOption "Wrap"; }
        bind "o" { SearchToggleOption "WholeWord"; }
    }

    entersearch {
        bind "Esc" { SwitchToMode "Scroll"; }
        bind "Enter" { SwitchToMode "Search"; }
    }

    renametab {
        bind "Esc" { UndoRenameTab; SwitchToMode "Normal"; }
        bind "Enter" { SwitchToMode "Normal"; }
    }

    session {
        bind "Esc" "Enter" "Alt o" { SwitchToMode "Normal"; }
        bind "d" { Detach; }
        bind "w" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Normal"
        }
        bind "p" {
            LaunchOrFocusPlugin "plugin-manager" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Normal"
        }
    }
}

themes {
    static-noise {
        fg "#E6E2D6"
        bg "#141720"
        // Inactive pane border (borde tenue para paneles inactivos)
        black "#343A4A"
        red "#EF7785"
        // Active pane border & highlight (borde cian dominante para foco)
        green "#72EAD5"
        yellow "#EDD071"
        // Title bar del panel activo
        blue "#83BFFF"
        magenta "#C2A7FF"
        cyan "#72EAD5"
        white "#E6E2D6"
        orange "#F3A261"

        // Componentes modernos de Zellij con tokens de Static Noise
        text_unselected {
            base 230 226 214        // #E6E2D6
            background 20 23 32     // #141720
            emphasis_0 114 234 213  // #72EAD5
            emphasis_1 131 191 255  // #83BFFF
            emphasis_2 194 167 255  // #C2A7FF
            emphasis_3 237 208 113  // #EDD071
        }

        text_selected {
            base 15 17 23           // #0F1117
            background 114 234 213  // #72EAD5
            emphasis_0 15 17 23     // #0F1117
            emphasis_1 239 119 133  // #EF7785
            emphasis_2 194 167 255  // #C2A7FF
            emphasis_3 243 162 97   // #F3A261
        }

        ribbon_unselected {
            base 230 226 214        // #E6E2D6
            background 27 31 42     // #1B1F2A
            emphasis_0 114 234 213  // #72EAD5
            emphasis_1 131 191 255  // #83BFFF
            emphasis_2 194 167 255  // #C2A7FF
            emphasis_3 237 208 113  // #EDD071
        }

        ribbon_selected {
            base 15 17 23           // #0F1117
            background 114 234 213  // #72EAD5
            emphasis_0 15 17 23     // #0F1117
            emphasis_1 239 119 133  // #EF7785
            emphasis_2 163 217 139  // #A3D98B
            emphasis_3 230 226 214  // #E6E2D6
        }

        list_unselected {
            base 230 226 214        // #E6E2D6
            background 20 23 32     // #141720
            emphasis_0 114 234 213  // #72EAD5
            emphasis_1 131 191 255  // #83BFFF
            emphasis_2 194 167 255  // #C2A7FF
            emphasis_3 237 208 113  // #EDD071
        }

        list_selected {
            base 230 226 214        // #E6E2D6
            background 25 60 59     // #193C3B (cyanDim)
            emphasis_0 114 234 213  // #72EAD5
            emphasis_1 163 217 139  // #A3D98B
            emphasis_2 237 208 113  // #EDD071
            emphasis_3 239 119 133  // #EF7785
        }

        table_title {
            base 114 234 213        // #72EAD5
            background 27 31 42     // #1B1F2A
            emphasis_0 230 226 214  // #E6E2D6
            emphasis_1 194 167 255  // #C2A7FF
            emphasis_2 237 208 113  // #EDD071
            emphasis_3 163 217 139  // #A3D98B
        }

        table_cell_unselected {
            base 230 226 214        // #E6E2D6
            background 20 23 32     // #141720
            emphasis_0 114 234 213  // #72EAD5
            emphasis_1 131 191 255  // #83BFFF
            emphasis_2 194 167 255  // #C2A7FF
            emphasis_3 237 208 113  // #EDD071
        }

        table_cell_selected {
            base 230 226 214        // #E6E2D6
            background 25 60 59     // #193C3B (cyanDim)
            emphasis_0 114 234 213  // #72EAD5
            emphasis_1 163 217 139  // #A3D98B
            emphasis_2 237 208 113  // #EDD071
            emphasis_3 239 119 133  // #EF7785
        }

        frame_unselected {
            base 52 58 74           // #343A4A
            background 20 23 32     // #141720
            emphasis_0 146 153 174  // #9299AE
            emphasis_1 201 200 194  // #C9C8C2
            emphasis_2 52 58 74     // #343A4A
            emphasis_3 27 31 42     // #1B1F2A
        }

        frame_selected {
            base 114 234 213        // #72EAD5
            background 20 23 32     // #141720
            emphasis_0 114 234 213  // #72EAD5
            emphasis_1 131 191 255  // #83BFFF
            emphasis_2 230 226 214  // #E6E2D6
            emphasis_3 194 167 255  // #C2A7FF
        }

        frame_highlight {
            base 114 234 213        // #72EAD5
            background 20 23 32     // #141720
            emphasis_0 131 191 255  // #83BFFF
            emphasis_1 194 167 255  // #C2A7FF
            emphasis_2 237 208 113  // #EDD071
            emphasis_3 239 119 133  // #EF7785
        }

        exit_code_success {
            base 163 217 139        // #A3D98B
            background 20 23 32     // #141720
            emphasis_0 114 234 213  // #72EAD5
            emphasis_1 131 191 255  // #83BFFF
            emphasis_2 194 167 255  // #C2A7FF
            emphasis_3 237 208 113  // #EDD071
        }

        exit_code_error {
            base 239 119 133        // #EF7785
            background 20 23 32     // #141720
            emphasis_0 114 234 213  // #72EAD5
            emphasis_1 131 191 255  // #83BFFF
            emphasis_2 194 167 255  // #C2A7FF
            emphasis_3 237 208 113  // #EDD071
        }
    }
}
