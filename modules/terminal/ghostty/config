# ==============================================================================
# CONFIGURACIÓN DE GHOSTTY (TEMA STATIC NOISE & JETBRAINS NERD FONT)
# ==============================================================================

# --- TIPOGRAFÍA Y FUENTES ---
font-family = "JetBrainsMono Nerd Font"
font-family = "JetBrains Mono"
font-size = 15
font-feature = ["liga", "calt"]

# --- TEMA ---
# El archivo se instala desde static-noise en ~/.config/ghostty/themes/.
theme = "static-noise"

# --- VENTANA Y EFECTOS VISUALES ---
window-decoration = false
window-padding-x = 12
window-padding-y = 10
background-opacity = 0.90
background-blur-radius = 20

# --- CURSOR ---
cursor-style = "block"
cursor-style-blink = false

# --- TECLADO Y MODIFICADORES (MACOS) ---
# Permite que la tecla Option emita secuencias Alt/Escape reales en terminal para Zellij
macos-option-as-alt = true

# --- INTEGRACIÓN CON FISH ---
shell-integration = "fish"
